# ── HTTPS redirect ──────────────────────────────────────────────────────────
# Active: SSL is enabled on the host (Let's Encrypt AutoSSL). Forces every
# request onto https. If you ever run locally on XAMPP without SSL, comment
# these out again or the local site will redirect-loop.
# Skip the redirect when a trusted proxy (ngrok, etc.) already terminated TLS
# and says so via X-Forwarded-Proto — otherwise Apache sees HTTPS=off on every
# tunneled request (since the proxy forwards plain HTTP) and 301-loops forever.
RewriteEngine On
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# ── Security headers ────────────────────────────────────────────────────────
<IfModule mod_headers.c>
    # Prevent browsers from sniffing MIME types
    Header always set X-Content-Type-Options "nosniff"

    # Block the page from being embedded in iframes (clickjacking protection)
    Header always set X-Frame-Options "DENY"

    # Enable browser XSS filter
    Header always set X-XSS-Protection "1; mode=block"

    # Do not send referrer to external sites
    Header always set Referrer-Policy "same-origin"

    # Remove server version banner
    Header unset Server
    Header always unset X-Powered-By
</IfModule>

# ── Block direct access to sensitive files ───────────────────────────────────
<FilesMatch "\.(env|sql|log|bak|sh|json|md|gitignore)$">
    Order allow,deny
    Deny from all
</FilesMatch>

# ── Disable directory listing ────────────────────────────────────────────────
Options -Indexes

# ── Legacy URL redirects ──────────────────────────────────────────────────────
# Root PHP files have been moved into pos-cafe/pages/legacy/.
# Redirect old URLs (e.g. /FinalSystem/view_order.php) to new clean URLs
# (e.g. /FinalSystem/pos-cafe/view_order) so the browser address bar updates.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/FinalSystem/pos-cafe/
RewriteRule ^([\w-]+)\.php$ /FinalSystem/pos-cafe/$1 [R=301,L,QSA]
